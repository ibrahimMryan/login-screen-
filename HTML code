<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login</title>

    <style>
        body {
            font-family: Arial;
            background-color: white;
        }

        .login-box {
            width: 250px;
            margin: 100px auto;
        }
    </style>
</head>
<body>

    <div class="login-box">
        <h2>Login</h2>

        <form>
            <label>Username</label><br>
            <input type="text"><br><br>

            <label>Password</label><br>
            <input type="password"><br><br>

            <button>Login</button>
        </form>
    </div>

</body>
</html>
